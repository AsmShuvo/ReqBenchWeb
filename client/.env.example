# ReqBench frontend configuration.
# Copy to .env. Only the dev server uses this file.

# Where the Vite dev server should proxy /api/* requests to.
# In local development this is the backend on http://localhost:3001.
# For a production build served separately from the API, set this
# to the public API origin (or remove and use a relative path with a reverse proxy).
VITE_SERVER_URL=http://localhost:3001
