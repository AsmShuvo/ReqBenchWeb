# ReqBench backend configuration.
# Copy to .env and fill in the values that apply to you.
# None of these secrets are needed just to send basic HTTP requests — they
# only unlock database persistence and AI features.

# PostgreSQL connection string (Neon serverless recommended — free tier).
# Required by Prisma (prisma migrate / prisma studio), /api/health/db, and
# all auth / sync routes (/api/auth/*, /api/sync/*).
# If unset, the server still boots and the HTTP proxy still works, but DB calls error.
DB_URL=postgresql://user:password@ep-xxxxx.region.aws.neon.tech/reqbench?sslmode=require

# JWT signing secret — REQUIRED for auth & sync.
# Generate a strong random value: `openssl rand -hex 48` or any password manager.
# Must be at least 16 characters. Changing it will invalidate all existing sessions.
JWT_SECRET=replace-me-with-a-long-random-string

# Groq API key (free tier). Required for the /api/ai/* routes.
# Get one at https://console.groq.com. Without it, AI endpoints return an error.
GROQ_API=gsk_your_groq_key_here

# Optional: override the Groq model. Defaults to llama-3.3-70b-versatile.
# Any chat-capable Groq model works; faster alternatives include llama-3.1-8b-instant.
# GROQ_MODEL=llama-3.3-70b-versatile
